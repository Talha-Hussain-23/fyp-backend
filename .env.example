# ===============================================
# SmartHiring Backend - Environment Configuration
# ===============================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control
# ===============================================

# -----------------------------------------------
# 1. DATABASE CONFIGURATION (REQUIRED)
# -----------------------------------------------
# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=SmartHiring
MONGODB_DB=HiringProcess

# -----------------------------------------------
# 2. SECURITY & AUTHENTICATION (REQUIRED)
# -----------------------------------------------
# Secret key for JWT token generation — use a strong 64+ char random string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# JWT Token Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Recruiter signup invite code
RECRUITER_INVITE_CODE=CHANGE_ME
ORGANIZATION_INVITE_CODE=CHANGE_ME

# -----------------------------------------------
# 3. APPLICATION SETTINGS
# -----------------------------------------------
# Environment: development | staging | production
ENVIRONMENT=production
DEBUG=False

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://your-app-domain.com
BASE_URL=https://your-app-domain.com

# Backend URL
BACKEND_URL=https://your-api-domain.com

# -----------------------------------------------
# 4. AI SERVICES (REQUIRED for interviews)
# -----------------------------------------------
# Groq API — Primary AI provider
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API — Fallback AI provider
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------
# 5. EMAIL SERVICE
# -----------------------------------------------
# Gmail OAuth2 — requires credentials.json + token.json
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_USER=your-email@gmail.com

# Optional: set refresh token directly instead of token.json
# GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Email branding
EMAIL_FROM_NAME=SmartHiring Platform
EMAIL_REPLY_TO=your-email@gmail.com

# -----------------------------------------------
# 6. REAL-TIME SERVICES
# -----------------------------------------------
# Socket.IO allowed origins (comma-separated)
SOCKETIO_CORS_ALLOWED_ORIGINS=https://your-app-domain.com

# Proctoring server
PROCTORING_SERVER_PORT=5000
PROCTORING_SERVER_HOST=0.0.0.0

# -----------------------------------------------
# 7. RATE LIMITING
# -----------------------------------------------
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=100

# -----------------------------------------------
# 8. FILE UPLOAD SETTINGS
# -----------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf,doc,docx
UPLOAD_DIR=uploads

# -----------------------------------------------
# 9. LOGGING & MONITORING
# -----------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
AUDIT_LOGGING_ENABLED=True

# -----------------------------------------------
# 10. PROCTORING SETTINGS
# -----------------------------------------------
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
MAX_PERSON_VIOLATIONS=3
MAX_PHONE_VIOLATIONS=2
MAX_TAB_SWITCHES=5

# -----------------------------------------------
# 11. INTERVIEW SETTINGS
# -----------------------------------------------
DEFAULT_INTERVIEW_DURATION=60
AUTO_TERMINATE_ON_TIMEOUT=True
ALLOW_RECLAIM_REQUESTS=True

# -----------------------------------------------
# 12. BRUTE FORCE PROTECTION
# -----------------------------------------------
MAX_SIGNUP_ATTEMPTS=5
SIGNUP_BLOCK_TIME=60

# -----------------------------------------------
# 13. DEVELOPMENT TOOLS (disable in production)
# -----------------------------------------------
ENABLE_DOCS=False
DETAILED_ERRORS=False

# ===============================================
# END OF CONFIGURATION
# ===============================================
